			<li><tt>public/</tt> είναι εγγράψιμο: {$writable_public}</li>
			<li><tt>cache/</tt> είναι εγγράψιμο: {$writable_cache}</li>
			<li><tt>cache/t_cache/</tt> είναι εγγράψιμο: {$writable_templates_cache}</li>

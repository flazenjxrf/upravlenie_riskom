roupSectionWillAppear";s:98:"Votre nom sera affiché sur la page Responsabilités de {$contextName} en tant que {$sectionName}.";s:55:"mailable.userRoleAssignmentInvitationNotify.description";s:80:"Ce courriel d'invitation est envoyé aux utilisateur/ices pour accepter un rôle";s:29:"emails.userRoleEndNotify.body";s:583:"<div class='email-container'>	<div class='email-header'>		<h2>Retrait d'un rôle</h2>	</div>	<div class='email-content'>		<p>Bonjour {$recipientName},</p>		<p>Nous vous remercions pour votre collaboration en tant que {$roleRemoved} pour {$contextName}.</p>		<p>Ce message vous informe que le rôle de {$roleRemoved} ne vous est désormais plus attribué. </p>		<p>Votre compte pour {$contextName} est cependant toujours actif ainsi que vos autres rôles.</p>		<p>N'hésitez pas à nous contacter pour toute question.</p>		<p>Bien cordialement,</p>		<p>{$contextName}</p>	</div></div>";s:58:"emails.userRoleAssignmentInvitationNotify.userGroupSection";s:275:"<div class='section'>    <div class='section-number'>{$sectionNumber}.</div>    <div class='section-content'>        <h2>{$sectionName}</h2>        <p>Date de début le {$dateStart}</p>        <p>{$sectionEndingDate}</p>        <p>{$sectionMastheadAppear}</p>    </div></div>";s:46:"emails.userRoleAssignmentInvitationNotify.body";s:1347:"<div class='email-container'>    <div class='email-header'>        <h2>Invitation à un nouveau rôle</h2>    </div>    <div class='email-content'>        
